{
  "swagger": "2.0",
  "info": {
    "title": "Chess API",
    "description": "Авторизация на cookie: /auth/login/{provider} ставит access_token и refresh_token, дальше браузер шлёт их сам.\n\nОшибки всегда в одном формате: {\"code\": \u003cgRPC-код\u003e, \"message\": \"...\", \"details\": []}. Решения на фронте — по HTTP-статусу, message только для логов.",
    "version": "1.0"
  },
  "tags": [
    {
      "name": "auth",
      "description": "Вход, обновление токена, выход"
    },
    {
      "name": "users",
      "description": "Пользователи"
    },
    {
      "name": "identity",
      "description": "Способы входа пользователя: список, привязка, отвязка"
    }
  ],
  "consumes": [
    "application/json"
  ],
  "produces": [
    "application/json"
  ],
  "paths": {
    "/api/v1/auth/login/{provider}": {
      "post": {
        "summary": "Вход через внешнего провайдера",
        "description": "Google принимает id_token в Authorization; Yandex принимает auth code в X-Auth-Code и, при PKCE, X-Code-Verifier. Ставит cookie access_token и refresh_token.",
        "operationId": "UsersService_Login",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/LoginResponse"
            }
          },
          "400": {
            "description": "Неизвестный провайдер",
            "schema": {
              "$ref": "#/definitions/Status"
            },
            "examples": {
              "application/json": {
                "code": 3,
                "message": "invalid argument",
                "details": []
              }
            }
          },
          "401": {
            "description": "Нет credentials или токен/код провайдера невалиден",
            "schema": {
              "$ref": "#/definitions/Status"
            },
            "examples": {
              "application/json": {
                "code": 16,
                "message": "unauthenticated",
                "details": []
              }
            }
          },
          "500": {
            "description": "Ошибка users-be (БД и т.п.)",
            "schema": {
              "$ref": "#/definitions/Status"
            },
            "examples": {
              "application/json": {
                "code": 13,
                "message": "internal error",
                "details": []
              }
            }
          }
        },
        "parameters": [
          {
            "name": "provider",
            "description": "Провайдер входа: google или yandex",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "tags": [
          "auth"
        ],
        "security": [
          {
            "IdToken": []
          }
        ]
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "summary": "Выход",
        "description": "Удаляет refresh_token на сервере и очищает обе cookie. Без cookie тоже отвечает 200.",
        "operationId": "UsersService_Logout",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/LogoutResponse"
            }
          },
          "500": {
            "description": "Ошибка users-be (БД и т.п.)",
            "schema": {
              "$ref": "#/definitions/Status"
            },
            "examples": {
              "application/json": {
                "code": 13,
                "message": "internal error",
                "details": []
              }
            }
          }
        },
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/refresh": {
      "post": {
        "summary": "Обновить access_token",
        "description": "Нужна cookie refresh_token. Ставит новую cookie access_token.",
        "operationId": "UsersService_Refresh",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/RefreshResponse"
            }
          },
          "401": {
            "description": "Нет cookie refresh_token, или токен не найден / истёк — нужен вход заново",
            "schema": {
              "$ref": "#/definitions/Status"
            },
            "examples": {
              "application/json": {
                "code": 16,
                "message": "unauthenticated",
                "details": []
              }
            }
          },
          "500": {
            "description": "Ошибка users-be (БД и т.п.)",
            "schema": {
              "$ref": "#/definitions/Status"
            },
            "examples": {
              "application/json": {
                "code": 13,
                "message": "internal error",
                "details": []
              }
            }
          }
        },
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/games": {
      "post": {
        "operationId": "GamesService_CreateGame",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/CreateGameResponse"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/CreateGameRequest"
            }
          }
        ]
      }
    },
    "/api/v1/identities": {
      "get": {
        "summary": "Способы входа",
        "description": "Все включённые провайдеры и уже привязанные. linked = true — можно отвязать, false — привязать.",
        "operationId": "UsersService_ListIdentities",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/ListIdentitiesResponse"
            }
          },
          "401": {
            "description": "Нет cookie access_token или токен истёк — вызвать /auth/refresh",
            "schema": {
              "$ref": "#/definitions/Status"
            },
            "examples": {
              "application/json": {
                "code": 16,
                "message": "unauthenticated",
                "details": []
              }
            }
          },
          "500": {
            "description": "Ошибка users-be (БД и т.п.)",
            "schema": {
              "$ref": "#/definitions/Status"
            },
            "examples": {
              "application/json": {
                "code": 13,
                "message": "internal error",
                "details": []
              }
            }
          }
        },
        "tags": [
          "identity"
        ]
      }
    },
    "/api/v1/identities/{provider}": {
      "delete": {
        "summary": "Отвязать способ входа",
        "description": "Нужна cookie access_token. Если провайдер не привязан — тоже 200.",
        "operationId": "UsersService_UnlinkIdentity",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/UnlinkIdentityResponse"
            }
          },
          "400": {
            "description": "Неизвестный провайдер (code 3) или это последний способ входа (code 9)",
            "schema": {
              "$ref": "#/definitions/Status"
            },
            "examples": {
              "application/json": {
                "code": 9,
                "message": "failed precondition",
                "details": []
              }
            }
          },
          "401": {
            "description": "Нет cookie access_token или токен истёк — вызвать /auth/refresh",
            "schema": {
              "$ref": "#/definitions/Status"
            },
            "examples": {
              "application/json": {
                "code": 16,
                "message": "unauthenticated",
                "details": []
              }
            }
          },
          "500": {
            "description": "Ошибка users-be (БД и т.п.)",
            "schema": {
              "$ref": "#/definitions/Status"
            },
            "examples": {
              "application/json": {
                "code": 13,
                "message": "internal error",
                "details": []
              }
            }
          }
        },
        "parameters": [
          {
            "name": "provider",
            "description": "Провайдер для отвязки: google или yandex",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "tags": [
          "identity"
        ]
      },
      "post": {
        "summary": "Привязать способ входа",
        "description": "Нужны cookie access_token (кто привязывает) и credentials Google или Yandex (что привязываем). Повторная привязка того же аккаунта — 200.",
        "operationId": "UsersService_LinkIdentity",
        "responses": {
          "200": {
            "description": "",
            "schema": {
              "$ref": "#/definitions/Identity",
              "required": [
                "identity"
              ]
            }
          },
          "400": {
            "description": "Неизвестный или выключенный провайдер",
            "schema": {
              "$ref": "#/definitions/Status"
            },
            "examples": {
              "application/json": {
                "code": 3,
                "message": "invalid argument",
                "details": []
              }
            }
          },
          "401": {
            "description": "Нет cookie access_token или credentials провайдера невалидны",
            "schema": {
              "$ref": "#/definitions/Status"
            },
            "examples": {
              "application/json": {
                "code": 16,
                "message": "unauthenticated",
                "details": []
              }
            }
          },
          "409": {
            "description": "Этот аккаунт провайдера привязан к другому пользователю, или у пользователя уже привязан другой аккаунт этого провайдера",
            "schema": {
              "$ref": "#/definitions/Status"
            },
            "examples": {
              "application/json": {
                "code": 6,
                "message": "already exists",
                "details": []
              }
            }
          },
          "500": {
            "description": "Ошибка users-be (БД и т.п.)",
            "schema": {
              "$ref": "#/definitions/Status"
            },
            "examples": {
              "application/json": {
                "code": 13,
                "message": "internal error",
                "details": []
              }
            }
          }
        },
        "parameters": [
          {
            "name": "provider",
            "description": "Провайдер входа для привязки: google или yandex",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "tags": [
          "identity"
        ],
        "security": [
          {
            "IdToken": []
          }
        ]
      }
    },
    "/api/v1/users/avatar": {
      "patch": {
        "summary": "Обновить аватар",
        "description": "Обновляет аватар.",
        "operationId": "UsersService_UpdateAvatar",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/UpdateAvatarResponse"
            }
          },
          "400": {
            "description": "Некорректный файл изображения",
            "schema": {
              "$ref": "#/definitions/Status"
            }
          },
          "401": {
            "description": "Нет cookie access_token или токен истёк",
            "schema": {
              "$ref": "#/definitions/Status"
            }
          },
          "500": {
            "description": "Ошибка при обновлении аватара",
            "schema": {
              "$ref": "#/definitions/Status"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/UpdateAvatarRequest"
            }
          }
        ],
        "tags": [
          "users"
        ]
      }
    },
    "/api/v1/users/me": {
      "patch": {
        "summary": "Изменить профиль",
        "description": "Обновляет данные профиля текущего пользователя. Нужна cookie access_token.",
        "operationId": "UsersService_UpdateProfile",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/UpdateProfileResponse"
            }
          },
          "400": {
            "description": "Переданы некорректные данные профиля",
            "schema": {
              "$ref": "#/definitions/Status"
            }
          },
          "401": {
            "description": "Нет cookie access_token или токен истёк",
            "schema": {
              "$ref": "#/definitions/Status"
            }
          },
          "409": {
            "description": "Конфликт данных профиля",
            "schema": {
              "$ref": "#/definitions/Status"
            }
          },
          "500": {
            "description": "Ошибка users-be (БД и т.п.)",
            "schema": {
              "$ref": "#/definitions/Status"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/UpdateProfileRequest"
            }
          }
        ],
        "tags": [
          "users"
        ]
      }
    },
    "/api/v1/users/profile": {
      "get": {
        "summary": "Получить профиль",
        "description": "Без ID возвращает профиль текущего пользователя. Нужна cookie access_token (ставит /auth/login/{provider}).",
        "operationId": "UsersService_GetProfile2",
        "responses": {
          "200": {
            "description": "",
