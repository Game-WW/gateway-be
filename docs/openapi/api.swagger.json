    "/api/v1/users/{user_id}/avatar": {
      "get": {
        "summary": "Получить аватар игрока",
        "description": "Возвращает аватар игрока в поле image в кодировке Base64. Если аватар не установлен, ответ 200 без поля image. Нужна cookie access_token.",
        "operationId": "UsersService_GetAvatar",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/GetAvatarResponse"
