  "definitions": {
    "Any": {
      "type": "object",
      "properties": {
        "@type": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "CreateGameRequest": {
      "type": "object",
      "properties": {
        "first_user_id": {
          "type": "string",
          "title": "ID создателя партии"
        },
        "second_user_id": {
          "type": "string",
          "title": "ID соперника"
        }
      }
    },
    "CreateGameResponse": {
      "type": "object",
      "properties": {
        "game": {
          "$ref": "#/definitions/Game",
          "title": "Состояние партии"
        }
      }
    },
    "Game": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "title": "ID партии"
        },
        "status": {
          "$ref": "#/definitions/GameStatus",
          "title": "Статус партии"
        },
        "fen": {
          "type": "string",
          "title": "Текущая позиция в нотации FEN"
        },
        "white_user_id": {
          "type": "string",
          "title": "ID игрока за белых"
        },
        "black_user_id": {
          "type": "string",
          "title": "ID игрока за чёрных"
        },
        "ply": {
          "type": "integer",
          "format": "int64",
          "title": "Число сыгранных полуходов"
        },
        "result": {
          "$ref": "#/definitions/GameResult",
          "title": "Результат партии"
        },
        "last_move_uci": {
          "type": "string",
          "title": "Последний ход в формате UCI"
        },
        "termination_reason": {
          "$ref": "#/definitions/TerminationReason",
          "title": "Причина завершения партии"
        },
        "draw_offered_by": {
          "$ref": "#/definitions/GameColor",
          "title": "Цвет игрока, предложившего ничью"
        }
      }
    },
    "GameColor": {
      "type": "string",
      "enum": [
        "GAME_COLOR_UNSPECIFIED",
        "GAME_COLOR_WHITE",
        "GAME_COLOR_BLACK"
      ],
      "default": "GAME_COLOR_UNSPECIFIED",
      "description": "- GAME_COLOR_UNSPECIFIED: Цвет не указан\n - GAME_COLOR_WHITE: Белые\n - GAME_COLOR_BLACK: Чёрные"
    },
    "GameResult": {
      "type": "string",
      "enum": [
        "GAME_RESULT_UNSPECIFIED",
        "GAME_RESULT_WHITE_WON",
        "GAME_RESULT_BLACK_WON",
        "GAME_RESULT_DRAW"
      ],
      "default": "GAME_RESULT_UNSPECIFIED",
      "description": "- GAME_RESULT_UNSPECIFIED: Результат не указан\n - GAME_RESULT_WHITE_WON: Победа белых\n - GAME_RESULT_BLACK_WON: Победа чёрных\n - GAME_RESULT_DRAW: Ничья"
    },
    "GameStatus": {
      "type": "string",
      "enum": [
        "GAME_STATUS_UNSPECIFIED",
        "GAME_STATUS_IN_PROGRESS",
        "GAME_STATUS_FINISHED"
      ],
      "default": "GAME_STATUS_UNSPECIFIED",
      "description": "- GAME_STATUS_UNSPECIFIED: Статус не указан\n - GAME_STATUS_IN_PROGRESS: Партия идёт\n - GAME_STATUS_FINISHED: Партия завершена"
    },
    "GetAvatarResponse": {
      "type": "object",
      "properties": {
        "image": {
          "type": "string",
          "format": "byte"
        }
      }
    },
    "GetProfileResponse": {
      "type": "object",
      "properties": {
        "user": {
          "$ref": "#/definitions/User"
        }
      }
    },
    "Identity": {
      "type": "object",
      "properties": {
        "provider": {
          "type": "string"
        },
        "linked": {
          "type": "boolean"
        },
        "email": {
          "type": "string"
        },
        "linked_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "provider",
        "linked"
      ]
    },
    "LinkIdentityResponse": {
      "type": "object",
      "properties": {
        "identity": {
          "$ref": "#/definitions/Identity"
        }
      },
      "required": [
        "identity"
      ]
    },
    "ListIdentitiesResponse": {
      "type": "object",
      "properties": {
        "identities": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/Identity"
          }
        }
      }
    },
    "LoginResponse": {
      "type": "object"
    },
    "LogoutResponse": {
      "type": "object"
    },
    "RefreshResponse": {
      "type": "object"
    },
    "Status": {
      "type": "object",
      "properties": {
        "code": {
          "type": "integer",
          "format": "int32"
        },
        "message": {
          "type": "string"
        },
        "details": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/Any"
          }
        }
      }
    },
    "TerminationReason": {
      "type": "string",
      "enum": [
        "TERMINATION_REASON_UNSPECIFIED",
        "TERMINATION_REASON_CHECKMATE",
        "TERMINATION_REASON_STALEMATE",
