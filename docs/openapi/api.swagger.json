{
  "swagger": "2.0",
  "info": {
    "title": "Chess API",
    "description": "Авторизация на cookie: /auth/login/{provider} ставит access_token и refresh_token, дальше браузер шлёт их сам.\n\nОшибки всегда в одном формате: {\"code\": \u003cgRPC-код\u003e, \"message\": \"...\", \"details\": []}. Решения на фронте — по HTTP-статусу, message только для логов.",
    "version": "1.0"
  },
  "tags": [
    {
      "name": "auth",
      "description": "Вход, обновление токена, выход"
    },
    {
      "name": "users",
      "description": "Пользователи"
    }
  ],
  "consumes": [
    "application/json"
  ],
  "produces": [
    "application/json"
  ],
  "paths": {
    "/api/v1/auth/login/{provider}": {
      "post": {
        "summary": "Вход через внешнего провайдера",
        "description": "Проверяет id_token провайдера и ставит cookie access_token и refresh_token.",
        "operationId": "UsersService_Login",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/LoginResponse"
            }
          },
          "400": {
            "description": "Неизвестный провайдер",
            "schema": {
              "$ref": "#/definitions/Status"
            },
            "examples": {
              "application/json": {
                "code": 3,
                "message": "invalid argument",
                "details": []
              }
            }
          },
          "401": {
            "description": "Нет Bearer или невалидный id_token",
            "schema": {
              "$ref": "#/definitions/Status"
            },
            "examples": {
              "application/json": {
                "code": 16,
                "message": "unauthenticated",
                "details": []
              }
            }
          },
          "500": {
            "description": "Ошибка users-be (БД и т.п.)",
            "schema": {
              "$ref": "#/definitions/Status"
            },
            "examples": {
              "application/json": {
                "code": 13,
                "message": "internal error",
                "details": []
              }
            }
          }
        },
        "parameters": [
          {
            "name": "provider",
            "description": "Провайдер, выдавший id_token: google",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "tags": [
          "auth"
        ],
        "security": [
          {
            "IdToken": []
          }
        ]
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "summary": "Выход",
        "description": "Удаляет refresh_token на сервере и очищает обе cookie. Без cookie тоже отвечает 200.",
        "operationId": "UsersService_Logout",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/LogoutResponse"
            }
          },
          "500": {
            "description": "Ошибка users-be (БД и т.п.)",
            "schema": {
              "$ref": "#/definitions/Status"
            },
            "examples": {
              "application/json": {
                "code": 13,
                "message": "internal error",
                "details": []
              }
            }
          }
        },
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/refresh": {
      "post": {
        "summary": "Обновить access_token",
        "description": "Нужна cookie refresh_token. Ставит новую cookie access_token.",
        "operationId": "UsersService_Refresh",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/RefreshResponse"
            }
          },
          "401": {
            "description": "Нет cookie refresh_token, или токен не найден / истёк — нужен вход заново",
            "schema": {
              "$ref": "#/definitions/Status"
            },
            "examples": {
              "application/json": {
                "code": 16,
                "message": "unauthenticated",
                "details": []
              }
            }
          },
          "500": {
            "description": "Ошибка users-be (БД и т.п.)",
            "schema": {
              "$ref": "#/definitions/Status"
            },
            "examples": {
              "application/json": {
                "code": 13,
                "message": "internal error",
                "details": []
              }
            }
          }
        },
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/users/me": {
      "get": {
        "summary": "Текущий пользователь",
        "description": "Нужна cookie access_token (ставит /auth/google).",
        "operationId": "UsersService_GetMe",
        "responses": {
          "200": {
            "description": "",
            "schema": {
              "$ref": "#/definitions/User"
            }
          },
          "401": {
            "description": "Нет cookie access_token или токен истёк — вызвать /auth/refresh",
            "schema": {
              "$ref": "#/definitions/Status"
            },
            "examples": {
              "application/json": {
                "code": 16,
                "message": "unauthenticated",
                "details": []
              }
            }
          },
          "404": {
            "description": "Пользователь из токена удалён из БД",
            "schema": {
              "$ref": "#/definitions/Status"
            },
            "examples": {
              "application/json": {
                "code": 5,
                "message": "not found",
                "details": []
              }
            }
          },
          "500": {
            "description": "Ошибка users-be (БД и т.п.)",
            "schema": {
              "$ref": "#/definitions/Status"
            },
            "examples": {
              "application/json": {
                "code": 13,
                "message": "internal error",
                "details": []
              }
            }
          }
        },
        "tags": [
          "users"
        ]
      }
    }
  },
  "definitions": {
    "Any": {
      "type": "object",
      "properties": {
        "@type": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "GetMeResponse": {
      "type": "object",
      "properties": {
        "user": {
          "$ref": "#/definitions/User"
        }
      }
    },
    "LoginResponse": {
      "type": "object"
    },
    "LogoutResponse": {
      "type": "object"
    },
    "RefreshResponse": {
      "type": "object"
    },
    "Status": {
      "type": "object",
      "properties": {
        "code": {
          "type": "integer",
          "format": "int32"
        },
        "message": {
          "type": "string"
        },
        "details": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/Any"
          }
        }
      }
    },
    "User": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "username": {
          "type": "string"
        },
        "email": {
          "type": "string"
        },
        "phone_number": {
          "type": "string"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "description": "Пользователь.",
      "required": [
        "id",
        "created_at"
      ]
    }
  },
  "securityDefinitions": {
    "IdToken": {
      "type": "apiKey",
      "description": "Bearer \u003cid_token провайдера\u003e",
      "name": "Authorization",
      "in": "header"
    }
  }
}
