            },
            "examples": {
              "application/json": {
                "code": 13,
                "message": "internal error",
                "details": []
              }
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "required": false,
            "type": "string"
          }
        ],
        "tags": [
          "users"
        ]
      }
    },
